# Required — free tier, no card: https://console.groq.com
GROQ_API_KEY=

# Optional — web search upgrade (1000 free credits/mo, no card): https://app.tavily.com
# Without it, the system falls back to DuckDuckGo (ddgs, keyless).
TAVILY_API_KEY=

# Optional — tracing: https://smith.langchain.com (5k traces/mo free)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# Model overrides (defaults shown)
# MODEL_REASONER=openai/gpt-oss-120b
# MODEL_WORKER=llama-3.1-8b-instant

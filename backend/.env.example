# Required — https://openrouter.ai/keys (only ':free' models are used; see config.py)
OPENROUTER_API_KEY=

# Optional — web search upgrade (1000 free credits/mo, no card): https://app.tavily.com
# Without it, the system falls back to DuckDuckGo (ddgs, keyless).
TAVILY_API_KEY=

# Optional — tracing: https://smith.langchain.com (5k traces/mo free)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# Model pool overrides (JSON lists, tried in order; every id must end in ":free")
# REASONER_MODELS=["google/gemma-4-31b-it:free","qwen/qwen3.8-27b:free"]
# WORKER_MODELS=["google/gemma-4-26b-a4b-it:free","liquid/lfm-2.5-2.6b:free"]
